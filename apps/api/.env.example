# Server — copy to .env and fill in (never commit .env)
NODE_ENV=development
PORT=4000
# Postgres (docker compose: postgresql://portfolio:$POSTGRES_PASSWORD@localhost:5432/portfolio)
DATABASE_URL=postgresql://portfolio:change-me@localhost:5432/portfolio
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_EXPIRES_IN=7d
# Comma-separated allowlist, e.g. https://mehedi-hasan.dev,http://localhost:3000
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
LOG_LEVEL=info
# Public /auth/register is blocked in production unless true
ALLOW_PUBLIC_REGISTER=false
# Seed admin (do not commit real values)
ADMIN_EMAIL=admin@mehedi.dev
ADMIN_PASSWORD=change-me-min-12-chars
# Docker only
POSTGRES_PASSWORD=change-me
PGADMIN_EMAIL=admin@portfolio.com
PGADMIN_PASSWORD=change-me
